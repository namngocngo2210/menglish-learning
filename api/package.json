{
  "name": "@bj/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BeeJunior api: CLI (migrate, import, export-snapshot, parity) now; Fastify server from S-B.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "cli": "tsx src/main.ts",
    "start": "tsx src/server/main.ts",
    "openapi": "tsx src/server/write-openapi.ts",
    "build": "esbuild src/server/main.ts src/main.ts --bundle --platform=node --target=node22 --format=esm --external:pg-native --outdir=dist --out-extension:.js=.mjs"
  },
  "dependencies": {
    "@bj/core": "*",
    "@bj/data": "*",
    "@bj/db-types": "*",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.7",
    "kysely": "^0.28.0",
    "node-pg-migrate": "^8.0.0",
    "pg": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
