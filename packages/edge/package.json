{
  "name": "@bj/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTML edge cache that runs in the web container in front of Next.js (SWR, single flight, stale-on-error, load shedding, purge, warmer).",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/edge.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.5"
  }
}
