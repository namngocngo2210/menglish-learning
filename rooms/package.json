{
  "name": "beejunior-rooms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:bank": "tsx scripts/build-bank.ts",
    "mem-check": "tsx scripts/mem-check.ts",
    "load-test": "tsx scripts/load-test.ts",
