# Names only. Real values live in a 600 env file on the host, placed by the owner (never in the repo, chat or logs).
# Off-host backup target: Cloudflare R2 (docs/backup-offsite-r2.md, ADR 0003). Used from sprint S-F.
# Copy to the host as a private env file; this template is the ".env.example" required by standards §7.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=beejunior-backups
R2_ENDPOINT=
# PUBLIC key only; the private key stays offline with the owner.
BACKUP_PUBLIC_KEY_FILE=
