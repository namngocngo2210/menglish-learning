# Names only. Real values live in a 600 env file on the host, placed by the owner (never in the repo, chat or logs).
# Off-host backup target: Cloudflare R2 (docs/backup-offsite-r2.md, ADR 0003). Used from sprint S-F.
# Copy to the host as a private env file; this template is the ".env.example" required by standards §7.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=beejunior-backups
R2_ENDPOINT=
# PUBLIC key only; the private key stays offline with the owner.
BACKUP_PUBLIC_KEY_FILE=

# --- S-A: database tooling (names only) -------------------------------------------------------
# Local/dev connection string for `npm run cli -w @bj/api -- <command>`; in production the api reads
# DATABASE_URL_FILE (a Docker secret) instead, so no password sits in the environment.
DATABASE_URL=
DATABASE_URL_FILE=
# Throwaway server for tests (CI uses a service container); one database per test file is created on it.
TEST_DATABASE_URL=
# deploy/compose.dev.yml
BJ_DEV_DB_PASSWORD=

# --- S-C: admin auth (names only; production uses *_FILE Docker secrets) ---------------------
SESSION_HMAC_KEY=
SESSION_HMAC_KEY_FILE=
TOTP_ENC_KEY=
TOTP_ENC_KEY_FILE=
ADMIN_ORIGIN=
TRUST_PROXY=

# --- S-U1: parent accounts (names only; default OFF = no /api/v1/account routes at all) ---------
ACCOUNTS_ENABLED=
USER_SESSION_HMAC_KEY=
USER_SESSION_HMAC_KEY_FILE=
ACCOUNTS_ORIGIN=
